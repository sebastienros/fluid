<Project Sdk="Microsoft.NET.Sdk">
  <!-- The logic of the playground without UI (options, URL state, rendering, samples), tested by Fluid.Tests/Playground. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fluid.Playground</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <!-- Compiled into LiquidGrammar by Tint's source generator (PlaygroundHighlighter.cs). -->
  <ItemGroup>
    <TintGrammar Include="Grammars\liquid.tmLanguage.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fluid\Fluid.csproj" />
    <PackageReference Include="Tint" />
    <PackageReference Include="Tint.Grammars" />
    <PackageReference Include="Tint.Themes" />
  </ItemGroup>
</Project>
