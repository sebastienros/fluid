<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Set the BenchmarkTargetFramework property to benchmark on another runtime, like net11.0 (c.f. HashingBenchmarks). -->
    <BenchmarkTargetFramework Condition="'$(BenchmarkTargetFramework)' == ''">net10.0</BenchmarkTargetFramework>
    <TargetFramework>$(BenchmarkTargetFramework)</TargetFramework>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <!-- Ignore vulnerable packages imported for benchmarking only -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <IsPackable>false</IsPackable>
    <SignAssembly>false</SignAssembly>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- RazorSlices compiles its templates with the Razor SDK's MVC support -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<CompilerGeneratedFilesOutputPath>obj\$(Configuration)\$(TargetFramework)</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="BenchmarkDotNet.Artifacts\**" />
    <EmbeddedResource Remove="BenchmarkDotNet.Artifacts\**" />
    <None Remove="BenchmarkDotNet.Artifacts\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="blogpost.liquid" />
    <None Remove="blogpost.mustache" />
    <None Remove="product.liquid" />
    <None Remove="product.mustache" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="product.mustache" />
    <EmbeddedResource Include="product.liquid" />
    <EmbeddedResource Include="blogpost.liquid" />
    <EmbeddedResource Include="blogpost.mustache" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="DotLiquid" />
    <PackageReference Include="Liquid.NET" />
    <PackageReference Include="Scriban" />
    <PackageReference Include="Handlebars.Net" />
    <PackageReference Include="Lissic" />
    <PackageReference Include="RazorSlices" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluid\Fluid.csproj" />
    <ProjectReference Include="..\Fluid.SourceGenerator\Fluid.SourceGenerator.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Analyzer Include="..\Fluid.SourceGenerator\bin\$(Configuration)\netstandard2.0\Fluid.SourceGenerator.dll" />
    <Analyzer Include="..\Fluid.SourceGenerator\bin\$(Configuration)\netstandard2.0\*.dll" />
  </ItemGroup>

  <Target Name="PreferMatchingFluidRuntime" AfterTargets="Build">
    <ItemGroup>
      <_RuntimeOverrides Include="..\Fluid\bin\$(Configuration)\$(TargetFramework)\Fluid.dll" />
      <_RuntimeOverrides Include="..\Fluid\bin\$(Configuration)\$(TargetFramework)\Parlot.dll" Condition="Exists('..\Fluid\bin\$(Configuration)\$(TargetFramework)\Parlot.dll')" />
    </ItemGroup>

    <Copy SourceFiles="@(_RuntimeOverrides)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <AdditionalFiles Include="*.liquid" />
  </ItemGroup>

</Project>
