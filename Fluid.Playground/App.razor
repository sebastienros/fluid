<div class="page @(_showOptions ? "options-open" : null)">
    <header class="toolbar">
        <a class="brand" href="../" title="Fluid documentation">
            <img src="logo.svg" alt="" width="28" height="28" />
            <span class="brand-name">fluid</span><span class="brand-sub">playground</span>
        </a>

        <label class="field">
            <span class="field-label">Sample</span>
            <select value="@_sampleId" @onchange="OnSampleChanged" aria-label="Sample">
                @if (_sampleId.Length == 0)
                {
                    <option value="">Custom</option>
                }
                @foreach (var sample in PlaygroundSamples.All)
                {
                    <option value="@sample.Id">@sample.Name</option>
                }
            </select>
        </label>

        <div class="actions">
            <button type="button" class="button" @onclick="ShareAsync" title="Copy a link to this template, its model and its options">@_shareLabel</button>
            <button type="button" class="button @(_showOptions ? "active" : null)" @onclick="() => _showOptions = !_showOptions" aria-expanded="@(_showOptions ? "true" : "false")" aria-controls="options">
                Options@(_changedOptions > 0 ? $" ({_changedOptions})" : null)
            </button>
            <a class="icon-button" href="../guide/getting-started/" title="Documentation" aria-label="Documentation">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h9.5L19 9v10.5H5Z"/><path d="M14 4.5V9h5M8.5 13h7M8.5 16.5h7"/></svg>
            </a>
            <button type="button" class="icon-button" @onclick="ToggleThemeAsync" title="Switch between dark and light theme" aria-label="Switch between dark and light theme">
                <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
                <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
            </button>
        </div>
    </header>

    <main class="workspace">
        <section class="pane editor" aria-label="Input">
            <div class="tabs" role="tablist">
                <button type="button" role="tab" class="tab @(_tab == TemplateTab ? "active" : null)" aria-selected="@(_tab == TemplateTab ? "true" : "false")" @onclick="() => _tab = TemplateTab">template.liquid</button>
                @for (var i = 0; i < _partials.Count; i++)
                {
                    var index = i;
                    <button type="button" role="tab" class="tab @(_tab == index ? "active" : null)" aria-selected="@(_tab == index ? "true" : "false")" @onclick="() => _tab = index">@(_partials[index].Name).liquid</button>
                }
                <button type="button" class="tab tab-add" @onclick="AddPartial" title="Add a partial template, for include, render and from">+ Partial</button>
                <button type="button" role="tab" class="tab tab-model @(_tab == ModelTab ? "active" : null)" aria-selected="@(_tab == ModelTab ? "true" : "false")" @onclick="() => _tab = ModelTab">model.json</button>
            </div>

            @if (_tab == TemplateTab)
            {
                <textarea class="code" spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off" aria-label="Template" value="@_template" @oninput="OnTemplateInput"></textarea>
            }
            else if (_tab == ModelTab)
            {
                <textarea class="code" spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off" aria-label="Model (JSON)" value="@_model" @oninput="OnModelInput"></textarea>
                <p class="hint">The properties of a JSON object are the variables of the template. Any other value is the <code>data</code> variable. Comments and trailing commas are allowed.</p>
            }
            else if (_tab >= 0 && _tab < _partials.Count)
            {
                var partial = _partials[_tab];
                <div class="partial-bar">
                    <label>Name <input type="text" value="@partial.Name" @onchange="e => RenamePartial(_tab, e.Value?.ToString())" spellcheck="false" aria-label="Partial name" /></label>
                    <code class="partial-usage">{% render '@partial.Name' %}</code>
                    <button type="button" class="link-button" @onclick="() => RemovePartial(_tab)">Remove</button>
                </div>
                <textarea class="code" spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off" aria-label="Partial template" value="@partial.Source" @oninput="e => OnPartialInput(_tab, e)"></textarea>
            }
        </section>

        <section class="pane output" aria-label="Output">
            <div class="tabs" role="tablist">
                <button type="button" role="tab" class="tab @(_preview ? null : "active")" aria-selected="@(_preview ? "false" : "true")" @onclick="() => _preview = false">Output</button>
                <button type="button" role="tab" class="tab @(_preview ? "active" : null)" aria-selected="@(_preview ? "true" : "false")" @onclick="() => _preview = true">HTML preview</button>
                <button type="button" class="tab tab-copy" @onclick="CopyOutputAsync" disabled="@(_result is null || _result.Error is not null)">@_copyLabel</button>
            </div>

            @if (_result?.Error is { } error)
            {
                <div class="error" role="alert">
                    <p class="error-kind">@ErrorTitle(error)@(error.Line is { } line ? $", line {line}" : null)@(error.Column is { } column ? $", column {column}" : null)</p>
                    <pre>@error.Message</pre>
                </div>
            }
            else if (_preview)
            {
                <iframe class="preview" sandbox="" title="HTML preview" srcdoc="@PreviewDocument"></iframe>
            }
            else
            {
                <pre class="code result">@_result?.Output</pre>
            }

            <footer class="status">
                @if (_result is { } result)
                {
                    <span title="FluidParser.Parse">parse @Ms(result.ParseTime)</span>
                    <span title="IFluidTemplate.RenderAsync">render @Ms(result.RenderTime)</span>
                    @if (result.Error is null)
                    {
                        <span>@result.Output.Length.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) chars</span>
                    }
                }
                @if (_readyMs is { } ready)
                {
                    <span class="status-ready" title="From the first byte of the page to the first rendering">ready in @ready.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) ms</span>
                }
            </footer>
        </section>

        <aside class="pane options" id="options" aria-label="Options">
            <div class="options-head">
                <h2>Options</h2>
                <button type="button" class="link-button" @onclick="ResetOptions" disabled="@(_changedOptions == 0)">Reset</button>
            </div>

            <fieldset>
                <legend>Syntax <a href="../guide/syntax/#functions" title="FluidParserOptions">?</a></legend>
                <label class="check"><input type="checkbox" checked="@_options.AllowFunctions" @onchange="e => Set(_options with { AllowFunctions = IsChecked(e) })" /> Functions and <code>macro</code></label>
                <label class="check"><input type="checkbox" checked="@_options.AllowParentheses" @onchange="e => Set(_options with { AllowParentheses = IsChecked(e) })" /> Parentheses</label>
                <label class="check"><input type="checkbox" checked="@_options.AllowLiquidTag" @onchange="e => Set(_options with { AllowLiquidTag = IsChecked(e) })" /> <code>liquid</code> tag</label>
                <label class="check"><input type="checkbox" checked="@_options.AllowStringEscapeSequences" @onchange="e => Set(_options with { AllowStringEscapeSequences = IsChecked(e) })" /> Escape sequences in strings</label>
                <label class="check"><input type="checkbox" checked="@_options.AllowTrailingQuestionMark" @onchange="e => Set(_options with { AllowTrailingQuestionMark = IsChecked(e) })" /> Identifiers ending with <code>?</code></label>
            </fieldset>

            <fieldset>
                <legend>Rendering <a href="../guide/rendering/" title="TemplateOptions">?</a></legend>
                <label class="check"><input type="checkbox" checked="@_options.HtmlEncode" @onchange="e => Set(_options with { HtmlEncode = IsChecked(e) })" /> HTML encoding</label>
                <label class="check"><input type="checkbox" checked="@_options.StrictVariables" @onchange="e => Set(_options with { StrictVariables = IsChecked(e) })" /> Strict variables</label>
                <label class="check"><input type="checkbox" checked="@_options.StrictFilters" @onchange="e => Set(_options with { StrictFilters = IsChecked(e) })" /> Strict filters</label>
            </fieldset>

            <fieldset>
                <legend>Whitespace <a href="../guide/syntax/#whitespace-control" title="WithTrimming, WithGreedy">?</a></legend>
                <label class="check"><input type="checkbox" checked="@HasTrimming(TrimmingFlags.TagLeft)" @onchange="e => SetTrimming(TrimmingFlags.TagLeft, e)" /> Trim left of tags</label>
                <label class="check"><input type="checkbox" checked="@HasTrimming(TrimmingFlags.TagRight)" @onchange="e => SetTrimming(TrimmingFlags.TagRight, e)" /> Trim right of tags</label>
                <label class="check"><input type="checkbox" checked="@HasTrimming(TrimmingFlags.OutputLeft)" @onchange="e => SetTrimming(TrimmingFlags.OutputLeft, e)" /> Trim left of outputs</label>
                <label class="check"><input type="checkbox" checked="@HasTrimming(TrimmingFlags.OutputRight)" @onchange="e => SetTrimming(TrimmingFlags.OutputRight, e)" /> Trim right of outputs</label>
                <label class="check"><input type="checkbox" checked="@_options.Greedy" @onchange="e => Set(_options with { Greedy = IsChecked(e) })" /> Greedy</label>
            </fieldset>

            <fieldset>
                <legend>Culture and dates <a href="../guide/localization/" title="WithCultureInfo, WithTimeZone">?</a></legend>
                <label class="select">Culture
                    <select value="@_options.Culture" @onchange="e => Set(_options with { Culture = e.Value?.ToString() ?? string.Empty })">
                        @foreach (var culture in PlaygroundEngine.Cultures)
                        {
                            <option value="@culture">@(culture.Length == 0 ? "Invariant" : culture)</option>
                        }
                    </select>
                </label>
                <label class="select">Time zone
                    <select value="@_options.TimeZone" @onchange="e => Set(_options with { TimeZone = e.Value?.ToString() ?? string.Empty })">
                        @foreach (var timeZone in PlaygroundEngine.TimeZones)
                        {
                            <option value="@timeZone">@(timeZone.Length == 0 ? "UTC" : timeZone)</option>
                        }
                    </select>
                </label>
            </fieldset>

            <fieldset>
                <legend>Filters <a href="../guide/filters/" title="WithMoneyFilters, WithColorFilters">?</a></legend>
                <label class="check"><input type="checkbox" checked="@_options.MoneyFilters" @onchange="e => Set(_options with { MoneyFilters = IsChecked(e) })" /> Money filters</label>
                <label class="check"><input type="checkbox" checked="@_options.ColorFilters" @onchange="e => Set(_options with { ColorFilters = IsChecked(e) })" /> Color filters</label>
            </fieldset>

            <fieldset>
                <legend>Limits <a href="../guide/security/#execution-limits" title="WithMaxSteps, WithMaxRecursion">?</a></legend>
                <label class="number">Max steps <input type="number" min="0" step="1000" value="@_options.MaxSteps" @onchange="e => Set(_options with { MaxSteps = ToInt(e, _options.MaxSteps) })" /></label>
                <label class="number">Max recursion <input type="number" min="0" value="@_options.MaxRecursion" @onchange="e => Set(_options with { MaxRecursion = ToInt(e, _options.MaxRecursion) })" /></label>
            </fieldset>

            <p class="hint">Fluid @FluidVersion, running in your browser with WebAssembly.</p>
        </aside>
    </main>
</div>
